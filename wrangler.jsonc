
{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "okx-smart-trader",
  "main": "worker.js",
  "compatibility_date": "2026-11-15",
  "keep_vars": true,
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "TRADER_KV",
      "id": "6f86d8eb656c42919d7263f6f9171d2e"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PAPER_LOCK",
        "class_name": "PaperLock"
      }
    ]
  },
  "exports": {
    "PaperLock": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
